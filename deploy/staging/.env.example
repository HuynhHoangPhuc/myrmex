# Staging environment variables
# Copy to .env and fill in values: cp .env.example .env

# Domain for Caddy auto-HTTPS (must have DNS A record pointing to VM IP)
STAGING_DOMAIN=staging.internalsystem.org

# Database (matches compose.yml defaults)
POSTGRES_DB=myrmex
POSTGRES_USER=myrmex
POSTGRES_PASSWORD=myrmex_dev

# LLM (optional — omit for mock provider)
LLM_API_KEY=
LLM_PROVIDER=mock
LLM_MODEL=

# JWT secret (CHANGE THIS — defaults to insecure dev value if empty)
JWT_SECRET=

# CORS allowed origins
CORS_ALLOWED_ORIGINS=https://staging.internalsystem.org

# OAuth (optional)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=https://staging.internalsystem.org/api/auth/oauth/google/callback
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT_ID=
OAUTH_MICROSOFT_REDIRECT_URL=https://staging.internalsystem.org/api/auth/oauth/microsoft/callback
OAUTH_FRONTEND_CALLBACK_URL=https://staging.internalsystem.org/auth/callback

# GCS backup bucket (created by Terraform)
GCS_BACKUP_BUCKET=
